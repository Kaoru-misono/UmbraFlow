--!strict
-- The run's pinned Tool catalog, as data. This is the SDK's `tools/list`.
--
-- Discovery is frozen DATA, not a call: the run's pinned catalog arrives as the
-- read-only JSON resource named below, is validated once while this module
-- loads, and is answered from there forever after. Reading it spends no
-- Tool-call budget and creates no ToolInvocation. It is ADVISORY: the Operator
-- validates the tool name, the arguments and the authority again on every call,
-- so a catalog that disagreed with the Operator can only make a caller refuse
-- early, never make the Operator accept.
--
-- This module is scoped rather than pure only because the resource it reads
-- exists only inside a scoped Tool program. It holds no capability at all: it
-- is not handed the private Tool Runtime table, and there is nothing here that
-- can reach the world. The modules a caller requires to CALL a Tool --
-- `@umbraflow/screen`, `@umbraflow/input`, one per Project Tool namespace --
-- are generated by the host from these same pinned bytes.
--
-- One entry is exactly what the host published for one Tool: its name, its
-- description, its flat input schema and the version of the declaration the
-- caller pinned. Nothing per-Tool is written here by hand, and a Tool added to
-- the catalog appears in `names()` and `describe()` with no edit to this file.

local catalog = {}

-- The read-only resource the host bakes the run's pinned Tool catalog into. It
-- is a resource rather than a native call because discovery must cost nothing
-- and must be identical on replay: the bytes are pinned at program
-- construction, so a description cannot change under a script mid-run.
local k_catalogResource = "umbraflow.tool-catalog"

local k_identityHexLength = 64

local function reject(message: string): never
    error("catalog " .. message, 3)
end

-- A load-time refusal, reported without a caller frame because there is no
-- script frame to blame: it fires while this module itself is loading.
local function refuseLoad(message: string): never
    error("catalog " .. message, 0)
end

-- The catalog, validated once. Every refusal here fails the whole scoped
-- generation rather than one call, which is correct: a catalog a script cannot
-- read is a program that cannot be reviewed.
local function loadedCatalog(): ({ [string]: any }, { string }, string)
    local document = resource.readJson(k_catalogResource)
    if type(document) ~= "table" then
        refuseLoad("resource must be a JSON object")
    end
    local digest = rawget(document, "catalog_hash")
    if
        type(digest) ~= "string"
        or #digest ~= k_identityHexLength
        or string.find(digest :: string, "^[0-9a-f]+$") == nil
    then
        refuseLoad("resource must carry a lowercase hex catalog_hash")
    end
    local entries = rawget(document, "tools")
    if type(entries) ~= "table" then
        refuseLoad("resource must carry a tools list")
    end

    local byName: { [string]: any } = {}
    local names: { string } = {}
    local count = rawlen(entries :: any)
    for index = 1, count do
        local entry = rawget(entries :: any, index)
        if type(entry) ~= "table" then
            refuseLoad("tools must all be descriptor objects")
        end
        local name = rawget(entry, "name")
        if type(name) ~= "string" or name == "" then
            refuseLoad("descriptor must name its tool")
        end
        -- Strictly increasing, which refuses an unsorted catalog and a
        -- duplicated tool in one comparison. The catalog owner renders the
        -- array in UTF-8 order of the names, so a catalog that arrives out of
        -- order is a catalog that was rewritten by something else.
        if index > 1 and not (names[index - 1] < (name :: string)) then
            refuseLoad("tools must be sorted by name and unique")
        end
        names[index] = name :: string
        byName[name :: string] = entry
    end
    if count == 0 then
        refuseLoad("resource declares no tool at all")
    end
    return byName, table.freeze(names), digest :: string
end

local descriptorByName, catalogNames, catalogHash = loadedCatalog()

-- The identity of the exact catalog bytes this run was pinned to. A script that
-- records it has recorded which descriptions it acted on.
catalog.hash = catalogHash

-- Every Tool this run may call, in UTF-8 order of the names. This is the list
-- the host's generated modules render into one function each, so discovery
-- and the callable surface can never disagree about what exists.
function catalog.names(): any
    return catalogNames
end

-- What one Tool is and what it takes: the host's own description and its flat
-- input schema, exactly as they were pinned -- or nothing at all, when this run
-- pinned no such Tool.
--
-- A miss answers `nil` rather than refusing, so this one function is also the
-- membership question and there is no second spelling of it. The refusal it
-- used to raise listed the whole pinned closure, which mattered while a call
-- named its Tool with a string; a call now names its Tool as an index chain and
-- Luau's own error names the segment that was not there.
function catalog.describe(name: any): any
    if type(name) ~= "string" then
        reject("describe needs a tool name string")
    end
    return descriptorByName[name]
end

return table.freeze(catalog)
