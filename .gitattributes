# Repository line-ending policy.
#
# Normalize every text file to LF in the repository AND the working tree (no CRLF
# anywhere, on any platform). Git auto-detects text vs binary; the explicit `binary`
# entries below protect asset / image / library files that auto-detection could
# misclassify and then corrupt by "normalizing".
#
# Enforced for first-party text by scripts/fix_format.py and the local CI entry
# points. Git applies this policy to every tracked text file.
* text=auto eol=lf

# --- Images -------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.JPG   binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.tga   binary
*.dds   binary
*.ktx   binary
*.exr   binary
*.hdr   binary

# --- Fonts --------------------------------------------------------------------------
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# --- Models / motion / asset binaries (MMD + glTF binary container) -----------------
# NOTE: .gltf is JSON (text) and is deliberately NOT listed here.
*.pmx   binary
*.pmd   binary
*.vmd   binary
*.vpd   binary
*.fbx   binary
*.glb   binary
*.spv   binary

# --- Audio --------------------------------------------------------------------------
*.wav   binary
*.mp3   binary
*.ogg   binary

# --- Archives / compiled binaries ---------------------------------------------------
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.bin   binary
*.dll   binary
*.lib   binary
*.exe   binary
*.pdb   binary
*.so    binary
*.dylib binary
*.a     binary
