      "name": "alpha",
      "plugin_id": "fixture.alpha",
      "tool_closure": {
        "$comment": "One entry per Tool this deployment declares, joined to that Tool by tool_bindings below. The set is stated here and the join is stated there, so neither can be derived from the other and the loader's cross-check has two sources to compare.",
