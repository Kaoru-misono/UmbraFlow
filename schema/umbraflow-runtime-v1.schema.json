{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraflow.dev/schema/runtime/v1",
  "title": "Umbraflow runtime model and observation contract",
  "description": "The canonical field-shape contract for page-model.toml and runtime resolution values. TOML array-of-table records map to the arrays in RuntimeModel.",
  "$ref": "#/$defs/RuntimeModel",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "PositiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "NonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "Size": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/PositiveInt" },
        { "$ref": "#/$defs/PositiveInt" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Rect": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/NonNegativeInt" },
        { "$ref": "#/$defs/NonNegativeInt" },
        { "$ref": "#/$defs/PositiveInt" },
        { "$ref": "#/$defs/PositiveInt" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "Offset": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "Point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "AssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.][.](?:/|$)).+"
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "Geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rect"],
          "properties": {
            "kind": { "const": "fixed" },
            "rect": { "$ref": "#/$defs/Rect" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rect", "axis", "item_size", "spacing"],
          "properties": {
            "kind": { "const": "collection" },
            "rect": { "$ref": "#/$defs/Rect" },
            "axis": { "enum": ["horizontal", "vertical"] },
            "item_size": { "$ref": "#/$defs/Size" },
            "spacing": { "$ref": "#/$defs/Size" },
            "max_items": { "$ref": "#/$defs/PositiveInt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anchor", "offset"],
          "properties": {
            "kind": { "const": "relative" },
            "anchor": { "$ref": "#/$defs/LocatorRef" },
            "offset": { "$ref": "#/$defs/Offset" }
          }
        }
      ]
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locators", "readers"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "kind": {
          "enum": ["control", "label", "indicator", "collection", "region"]
        },
        "geometry": { "$ref": "#/$defs/Geometry" },
        "locators": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "readers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "uniqueItems": true
        }
      }
    },
    "LocatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": { "$ref": "#/$defs/Identifier" },
        "variant": { "$ref": "#/$defs/Identifier" }
      }
    },
    "Locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "template" },
            "asset": { "$ref": "#/$defs/AssetRef" },
            "threshold": { "$ref": "#/$defs/Confidence" },
            "search_rect": { "$ref": "#/$defs/Rect" },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "anyOf": [
            { "required": ["asset"] },
            { "required": ["variants"] }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "reader"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "text" },
            "reader": { "$ref": "#/$defs/Identifier" },
            "search_rect": { "$ref": "#/$defs/Rect" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "rect"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "geometry" },
            "rect": { "$ref": "#/$defs/Rect" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "anchor", "offset"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "relative" },
            "anchor": { "$ref": "#/$defs/LocatorRef" },
            "offset": { "$ref": "#/$defs/Offset" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "item_locator", "axis", "spacing"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "collection" },
            "item_locator": { "$ref": "#/$defs/LocatorRef" },
            "axis": { "enum": ["horizontal", "vertical"] },
            "spacing": { "$ref": "#/$defs/Size" },
            "max_items": { "$ref": "#/$defs/PositiveInt" }
          }
        }
      ]
    },
    "LocatorVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "asset"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "locator": { "$ref": "#/$defs/Identifier" },
        "asset": { "$ref": "#/$defs/AssetRef" },
        "threshold": { "$ref": "#/$defs/Confidence" },
        "search_rect": { "$ref": "#/$defs/Rect" }
      }
    },
    "Reader": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "confidence_floor", "normalization"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "line" },
            "confidence_floor": { "$ref": "#/$defs/Confidence" },
            "normalization": {
              "enum": ["raw", "trim", "collapse_whitespace"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "confidence_floor", "normalization", "join"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "block" },
            "confidence_floor": { "$ref": "#/$defs/Confidence" },
            "normalization": {
              "enum": ["raw", "trim", "collapse_whitespace"]
            },
            "join": { "enum": ["newline", "space"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "confidence_floor", "item_kind"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "items" },
            "confidence_floor": { "$ref": "#/$defs/Confidence" },
            "item_kind": { "enum": ["line", "block"] },
            "min_items": { "$ref": "#/$defs/NonNegativeInt" },
            "max_items": { "$ref": "#/$defs/PositiveInt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "target", "kind", "confidence_floor"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "target": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "presence" },
            "confidence_floor": { "$ref": "#/$defs/Confidence" }
          }
        }
      ]
    },
    "Surface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "contexts"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "scene" },
            "contexts": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "contexts", "covers"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "overlay" },
            "contexts": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "minItems": 1,
              "uniqueItems": true
            },
            "covers": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "contexts"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "interrupt" },
            "contexts": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "Placement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "target_geometry" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rect"],
          "properties": {
            "kind": { "const": "rect" },
            "rect": { "$ref": "#/$defs/Rect" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anchor", "offset"],
          "properties": {
            "kind": { "const": "relative" },
            "anchor": { "$ref": "#/$defs/LocatorRef" },
            "offset": { "$ref": "#/$defs/Offset" }
          }
        }
      ]
    },
    "TextPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reader", "operator", "value"],
          "properties": {
            "kind": { "const": "text_match" },
            "reader": { "$ref": "#/$defs/Identifier" },
            "operator": { "const": "equals" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reader", "operator", "value"],
          "properties": {
            "kind": { "const": "text_match" },
            "reader": { "$ref": "#/$defs/Identifier" },
            "operator": { "const": "contains_all" },
            "value": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reader", "operator"],
          "properties": {
            "kind": { "const": "text_match" },
            "reader": { "$ref": "#/$defs/Identifier" },
            "operator": { "const": "present" }
          }
        }
      ]
    },
    "IdentityPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "const": "locator_present" },
            "locator": { "$ref": "#/$defs/LocatorRef" }
          }
        },
        { "$ref": "#/$defs/TextPredicate" }
      ]
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "none"],
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/IdentityPredicate" },
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/IdentityPredicate" },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": { "$ref": "#/$defs/IdentityPredicate" },
          "uniqueItems": true
        }
      }
    },
    "ActionPrecondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "const": "locator_present" },
            "locator": { "$ref": "#/$defs/LocatorRef" }
          }
        },
        { "$ref": "#/$defs/TextPredicate" }
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "locator", "preconditions"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "click" },
            "locator": { "$ref": "#/$defs/LocatorRef" },
            "preconditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/ActionPrecondition" },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "key", "preconditions"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "key" },
            "key": { "type": "string", "minLength": 1, "maxLength": 64 },
            "locator": { "$ref": "#/$defs/LocatorRef" },
            "preconditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/ActionPrecondition" },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "axis", "delta", "preconditions"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "scroll" },
            "axis": { "enum": ["horizontal", "vertical"] },
            "delta": { "type": "integer", "not": { "const": 0 } },
            "locator": { "$ref": "#/$defs/LocatorRef" },
            "preconditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/ActionPrecondition" },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "locator", "destination", "preconditions"],
          "properties": {
            "id": { "$ref": "#/$defs/Identifier" },
            "kind": { "const": "drag" },
            "locator": { "$ref": "#/$defs/LocatorRef" },
            "destination": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "point"],
                  "properties": {
                    "kind": { "const": "point" },
                    "point": { "$ref": "#/$defs/Point" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "locator"],
                  "properties": {
                    "kind": { "const": "locator" },
                    "locator": { "$ref": "#/$defs/LocatorRef" }
                  }
                }
              ]
            },
            "preconditions": {
              "type": "array",
              "items": { "$ref": "#/$defs/ActionPrecondition" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "target", "placement", "identity", "readers", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "surface": { "$ref": "#/$defs/Identifier" },
        "target": { "$ref": "#/$defs/Identifier" },
        "placement": { "$ref": "#/$defs/Placement" },
        "identity": { "$ref": "#/$defs/Identity" },
        "readers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Action" },
          "uniqueItems": true
        }
      }
    },
    "RuntimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "surfaces"],
      "properties": {
        "context": { "$ref": "#/$defs/Identifier" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "StatePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "surfaces"],
      "properties": {
        "context": { "$ref": "#/$defs/Identifier" },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "Trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "action"],
          "properties": {
            "kind": { "const": "action" },
            "binding": { "$ref": "#/$defs/Identifier" },
            "action": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "milliseconds"],
          "properties": {
            "kind": { "const": "timeout" },
            "milliseconds": { "$ref": "#/$defs/NonNegativeInt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "external" },
            "name": { "$ref": "#/$defs/Identifier" }
          }
        }
      ]
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "trigger", "to", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "from": { "$ref": "#/$defs/StatePattern" },
        "trigger": { "$ref": "#/$defs/Trigger" },
        "to": { "$ref": "#/$defs/StatePattern" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeout_ms", "attempts"],
          "properties": {
            "kind": { "const": "resolve" },
            "timeout_ms": { "$ref": "#/$defs/NonNegativeInt" },
            "attempts": { "$ref": "#/$defs/PositiveInt" }
          }
        }
      }
    },
    "RuntimeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "base_resolution",
        "base_dpi",
        "contexts",
        "targets",
        "locators",
        "locator_variants",
        "readers",
        "surfaces",
        "bindings",
        "transitions"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "base_resolution": { "$ref": "#/$defs/Size" },
        "base_dpi": { "$ref": "#/$defs/Size" },
        "contexts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Context" },
          "minItems": 1,
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Target" },
          "minItems": 1,
          "uniqueItems": true
        },
        "locators": {
          "type": "array",
          "items": { "$ref": "#/$defs/Locator" },
          "minItems": 1,
          "uniqueItems": true
        },
        "locator_variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocatorVariant" },
          "uniqueItems": true
        },
        "readers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Reader" },
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/Surface" },
          "minItems": 1,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Binding" },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Transition" },
          "uniqueItems": true
        }
      }
    },
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["locator", "reader", "geometry"] },
        "target": { "$ref": "#/$defs/Identifier" },
        "locator": { "$ref": "#/$defs/LocatorRef" },
        "reader": { "$ref": "#/$defs/Identifier" },
        "score": { "type": "number" },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "rect": { "$ref": "#/$defs/Rect" }
      }
    },
    "Present": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "confidence", "proof"],
      "properties": {
        "kind": { "const": "present" },
        "value": {},
        "confidence": { "$ref": "#/$defs/Confidence" },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/Proof" },
          "minItems": 1
        }
      }
    },
    "Absent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proof"],
      "properties": {
        "kind": { "const": "absent" },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/Proof" },
          "minItems": 1
        }
      }
    },
    "Unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "unknown" },
        "reason": {
          "enum": [
            "not_measured",
            "low_confidence",
            "ocr_unreadable",
            "locator_failed",
            "incompatible_geometry",
            "stale_frame",
            "internal_error"
          ]
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/Proof" }
        }
      }
    },
    "EvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "subject": { "$ref": "#/$defs/Identifier" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/Present" },
            { "$ref": "#/$defs/Absent" },
            { "$ref": "#/$defs/Unknown" }
          ]
        }
      }
    },
    "ResolutionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "score", "evidence"],
      "properties": {
        "state": { "$ref": "#/$defs/RuntimeState" },
        "score": { "type": "number" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1
        }
      }
    },
    "ResolutionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "surfaces", "message"],
      "properties": {
        "kind": {
          "enum": [
            "multiple_candidates",
            "insufficient_identity",
            "incompatible_stack",
            "unknown_evidence"
          ]
        },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "Resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "evidence"],
      "properties": {
        "kind": { "const": "resolved" },
        "state": { "$ref": "#/$defs/RuntimeState" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRecord" },
          "minItems": 1
        }
      }
    },
    "Ambiguous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidates", "conflicts", "evidence"],
      "properties": {
        "kind": { "const": "ambiguous" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResolutionCandidate" },
          "minItems": 2
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ResolutionConflict" },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRecord" }
        }
      }
    },
    "UnknownResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "evidence"],
      "properties": {
        "kind": { "const": "unknown" },
        "reason": {
          "enum": [
            "no_surface_candidate",
            "insufficient_identity",
            "unknown_evidence",
            "incompatible_context",
            "invalid_stack"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRecord" }
        },
        "diagnostic": { "type": "string", "minLength": 1 }
      }
    },
    "Resolution": {
      "oneOf": [
        { "$ref": "#/$defs/Resolved" },
        { "$ref": "#/$defs/Ambiguous" },
        { "$ref": "#/$defs/UnknownResolution" }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "ticket_id",
        "cycle_id",
        "frame_id",
        "model_hash",
        "state",
        "surface",
        "binding",
        "action",
        "evidence_ids",
        "authorization"
      ],
      "properties": {
        "kind": { "const": "receipt" },
        "id": { "$ref": "#/$defs/Identifier" },
        "ticket_id": { "type": "string", "minLength": 1 },
        "cycle_id": { "type": "string", "minLength": 1 },
        "frame_id": { "type": "string", "minLength": 1 },
        "model_hash": { "$ref": "#/$defs/Sha256" },
        "state": { "$ref": "#/$defs/RuntimeState" },
        "surface": { "$ref": "#/$defs/Identifier" },
        "binding": { "$ref": "#/$defs/Identifier" },
        "action": { "$ref": "#/$defs/Identifier" },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticket_id", "cycle_id", "target", "action"],
          "properties": {
            "ticket_id": { "type": "string", "minLength": 1 },
            "cycle_id": { "type": "string", "minLength": 1 },
            "target": { "$ref": "#/$defs/Identifier" },
            "action": { "$ref": "#/$defs/Identifier" }
          }
        }
      }
    }
  }
}
