{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraflow.dev/schema/umbraflow-runtime-v2.schema.json",
  "title": "Umbraflow RuntimeModel v2",
  "description": "Field shapes for the trusted RuntimeModel parser and its two-stage results. Cross-reference, coverage, placement and same-cycle authority rules are enforced by the trusted Luau compiler/resolver.",
  "$ref": "#/$defs/runtime_model",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "asset_path": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "size": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "ui_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["control", "region"] }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "asset_path", "threshold"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "template" },
        "asset_path": { "$ref": "#/$defs/asset_path" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "confidence_floor", "normalization"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "text" },
        "confidence_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalization": { "enum": ["raw", "trim", "collapse_whitespace"] }
      }
    },
    "locator_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "const": "locator_present" },
        "locator": { "$ref": "#/$defs/identifier" }
      }
    },
    "text_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reader", "value"],
      "properties": {
        "kind": { "const": "text_equals" },
        "reader": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string" }
      }
    },
    "predicate": {
      "oneOf": [
        { "$ref": "#/$defs/locator_predicate" },
        { "$ref": "#/$defs/text_predicate" }
      ]
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "none"],
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "none": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        }
      },
      "anyOf": [
        { "properties": { "all": { "minItems": 1 } } },
        { "properties": { "any": { "minItems": 1 } } }
      ]
    },
    "surface_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "none"],
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "anyOf": [
        { "properties": { "all": { "minItems": 1 } } },
        { "properties": { "any": { "minItems": 1 } } }
      ]
    },
    "fixed_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rect"],
      "properties": {
        "kind": { "const": "fixed" },
        "rect": { "$ref": "#/$defs/rect" },
        "action_point": { "$ref": "#/$defs/point" }
      }
    },
    "click_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "proof_locator"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "click" },
        "proof_locator": { "$ref": "#/$defs/identifier" }
      }
    },
    "key_action": {
      "$comment": "One keystroke the target's own UI prints as an affordance. It carries no coordinate: which key is pressed is the whole of what is delivered, and the Binding's placement exists here to hold the proof_locator's rectangle rather than to aim anything. proof_locator means what it means for a click -- not proof the keystroke happened, but that a template belonging to this Binding's own detector was re-measured present on this very cycle, so the screen that accepts the key is the screen that is showing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "key", "proof_locator"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "key" },
        "key": {
          "$comment": "The key spelled exactly as the target prints it. The accepted vocabulary is closed and is defined once, in the trusted C++ KeyName, which refuses a name outside it and prints the whole set it refused against; restating that set here would be a second spelling of one rule. This names a key on the TARGET's keyboard and never one the operator presses.",
          "type": "string",
          "minLength": 1
        },
        "proof_locator": { "$ref": "#/$defs/identifier" }
      }
    },
    "binding_action": {
      "oneOf": [
        { "$ref": "#/$defs/click_action" },
        { "$ref": "#/$defs/key_action" }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "ui_target",
        "variant",
        "placement",
        "detector",
        "actions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "surface": { "$ref": "#/$defs/identifier" },
        "ui_target": { "$ref": "#/$defs/identifier" },
        "variant": { "$ref": "#/$defs/identifier" },
        "placement": { "$ref": "#/$defs/fixed_placement" },
        "detector": { "$ref": "#/$defs/detector" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/binding_action" }
        },
        "reads": {
          "$comment": "Readers whose normalised value this Binding reports once it is measured present. A reader named here never decides the detector: text is evidence about what is on a Surface, never the identity of one. Absent is the empty list, which is what most Bindings declare; making it required would say nothing on every Binding that reports nothing.",
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "$comment": "action_point exists exactly when some action needs a coordinate. The condition reads 'every action names no coordinate', which is also true of a Binding granting no action at all, so both of those forbid the point and only a click requires one. Dragging a coordinate through a keystroke would put a number in the model that nothing measures and nothing delivers.",
          "if": {
            "properties": {
              "actions": {
                "items": { "properties": { "kind": { "const": "key" } } }
              }
            }
          },
          "then": {
            "properties": {
              "placement": { "not": { "required": ["action_point"] } }
            }
          },
          "else": {
            "properties": { "placement": { "required": ["action_point"] } }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "covers", "identity"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["scene", "overlay", "interrupt"] },
        "covers": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "identity": { "$ref": "#/$defs/surface_identity" }
      }
    },
    "transition_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "action"],
      "properties": {
        "binding": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/identifier" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_surfaces", "trigger", "to_surfaces"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "trigger": { "$ref": "#/$defs/transition_trigger" },
        "to_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "runtime_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "base_resolution",
        "base_dpi",
        "ui_targets",
        "locators",
        "readers",
        "bindings",
        "surfaces",
        "transitions"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "base_resolution": { "$ref": "#/$defs/size" },
        "base_dpi": { "$ref": "#/$defs/size" },
        "ui_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ui_target" }
        },
        "locators": {
          "type": "array",
          "items": { "$ref": "#/$defs/locator" }
        },
        "readers": {
          "type": "array",
          "items": { "$ref": "#/$defs/reader" }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    },
    "template_evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding", "locator"],
      "properties": {
        "kind": { "const": "template" },
        "binding": { "$ref": "#/$defs/identifier" },
        "locator": { "$ref": "#/$defs/identifier" }
      }
    },
    "text_evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding", "reader"],
      "properties": {
        "kind": { "const": "text" },
        "binding": { "$ref": "#/$defs/identifier" },
        "reader": { "$ref": "#/$defs/identifier" }
      }
    },
    "missing_evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding", "predicate"],
      "properties": {
        "kind": { "const": "measurement" },
        "binding": { "$ref": "#/$defs/identifier" },
        "predicate": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_source": {
      "oneOf": [
        { "$ref": "#/$defs/template_evidence_source" },
        { "$ref": "#/$defs/text_evidence_source" },
        { "$ref": "#/$defs/missing_evidence_source" }
      ]
    },
    "unknown_reason": {
      "$comment": "Why one measurement could not be decided. One closed vocabulary, referenced by everything that reports an Unknown, because a reason spelled twice is two vocabularies that agree by test rather than by construction.",
      "enum": [
        "not_measured",
        "low_confidence",
        "ocr_unreadable",
        "locator_failed",
        "stale_cycle",
        "host_unavailable",
        "internal_error"
      ]
    },
    "present_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "confidence", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "present" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "$ref": "#/$defs/evidence_source" }
      }
    },
    "absent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "absent" },
        "source": { "$ref": "#/$defs/evidence_source" }
      }
    },
    "unknown_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reason", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "unknown" },
        "reason": { "$ref": "#/$defs/unknown_reason" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "$ref": "#/$defs/evidence_source" }
      }
    },
    "evidence_summary": {
      "oneOf": [
        { "$ref": "#/$defs/present_evidence" },
        { "$ref": "#/$defs/absent_evidence" },
        { "$ref": "#/$defs/unknown_evidence" }
      ]
    },
    "binding_reading": {
      "$comment": "One reading the resolver reports for a Binding it measured present, under a Reader that Binding named in reads. Three outcomes and no fourth: read carries the text, absent says the Reader found no text in that rectangle, unknown says it could not decide and carries why. The two failures are reported rather than dropped because a consumer that cannot tell 'nothing is written here' from 'this frame was unreadable' has to fail closed on one blurry capture. What is still not carried is the score: it has already been compared against the Reader's confidence_floor, and it differs between two captures of one unchanged screen while this value is hashed into a decision basis. A bounded reason is safe there; a float is not. There is no rectangle for the reason U-04 gives, and no pre-normalisation text because that is the raw read the Reader exists to narrow.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reader", "ui_target"],
      "properties": {
        "kind": { "enum": ["read", "absent", "unknown"] },
        "reader": { "$ref": "#/$defs/identifier" },
        "reason": { "$ref": "#/$defs/unknown_reason" },
        "text": { "type": "string" },
        "ui_target": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "read" } },
            "required": ["kind"]
          },
          "then": { "required": ["text"] },
          "else": { "not": { "required": ["text"] } }
        },
        {
          "if": {
            "properties": { "kind": { "const": "unknown" } },
            "required": ["kind"]
          },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        }
      ]
    },
    "state_readings": {
      "$comment": "Every reading a resolved state reports, ordered by ui_target then reader so one world produces one document. One entry per Reader every reporting Binding named, whatever the outcome, so the length is decided by the model and the resolved stack rather than by what the Host managed to answer. It is keyed by UiTarget rather than by Binding because a Binding names a visual variant, and the variant a hover or a highlight selects changes between two captures of one semantic instance. Two present Bindings sharing a UiTarget report nothing for it: which instance is on screen is exactly what an ambiguity means.",
      "type": "array",
      "items": { "$ref": "#/$defs/binding_reading" }
    },
    "resolved_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "ordered_surface_stack", "evidence"],
      "properties": {
        "kind": { "const": "resolved_state" },
        "id": { "type": "string", "minLength": 1 },
        "ordered_surface_stack": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "unknown_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "evidence"],
      "properties": {
        "kind": { "const": "unknown_state" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "ambiguous_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidates", "conflicts", "evidence"],
      "properties": {
        "kind": { "const": "ambiguous_state" },
        "candidates": { "type": "array", "items": { "type": "object" } },
        "conflicts": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "state_resolution": {
      "oneOf": [
        { "$ref": "#/$defs/resolved_state" },
        { "$ref": "#/$defs/unknown_state" },
        { "$ref": "#/$defs/ambiguous_state" }
      ]
    },
    "resolved_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "state_identity",
        "surface",
        "ui_target",
        "binding",
        "variant",
        "evidence"
      ],
      "properties": {
        "kind": { "const": "resolved_binding" },
        "id": { "type": "string", "minLength": 1 },
        "state_identity": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/identifier" },
        "ui_target": { "$ref": "#/$defs/identifier" },
        "binding": { "$ref": "#/$defs/identifier" },
        "variant": { "$ref": "#/$defs/identifier" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "unknown_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "evidence"],
      "properties": {
        "kind": { "const": "unknown_binding" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "ambiguous_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidates", "evidence"],
      "properties": {
        "kind": { "const": "ambiguous_binding" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_summary" }
        }
      }
    },
    "binding_resolution": {
      "oneOf": [
        { "$ref": "#/$defs/resolved_binding" },
        { "$ref": "#/$defs/unknown_binding" },
        { "$ref": "#/$defs/ambiguous_binding" }
      ]
    },
    "receipt_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "state_identity",
        "surface",
        "ui_target",
        "binding",
        "variant",
        "action",
        "action_kind",
        "evidence_ids"
      ],
      "properties": {
        "kind": { "const": "receipt_request" },
        "id": { "type": "string", "minLength": 1 },
        "state_identity": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/identifier" },
        "ui_target": { "$ref": "#/$defs/identifier" },
        "binding": { "$ref": "#/$defs/identifier" },
        "variant": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/identifier" },
        "action_kind": { "enum": ["click", "key"] },
        "key": {
          "$comment": "The key the authorized action names, copied from the Binding action so the Host is told what to deliver without reading the model. Same closed vocabulary as key_action.key, and same single definition.",
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action_kind": { "const": "key" } },
            "required": ["action_kind"]
          },
          "then": { "required": ["key"] },
          "else": { "not": { "required": ["key"] } }
        }
      ]
    }
  }
}
