{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraflow.local/schema/journal-v1",
  "title": "Umbraflow Project Journal envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/JournalEvent" },
    { "$ref": "#/$defs/ProjectState" },
    { "$ref": "#/$defs/ProjectInstance" }
  ],
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "NamespacedIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$"
    },
    "CanonicalJsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/CanonicalJsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/CanonicalJsonValue" }
        }
      ]
    },
    "JournalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principal_id", "source_hashes", "observation_ids"],
      "properties": {
        "kind": {
          "enum": ["client_db", "observation", "inference", "policy", "human_correction"]
        },
        "principal_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Identifier" }
          ]
        },
        "source_hashes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Hash" },
          "uniqueItems": true
        },
        "observation_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "uniqueItems": true
        }
      }
    },
    "JournalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "plugin_id",
        "project_instance_key",
        "sequence",
        "prior_project_state_revision",
        "operation_id",
        "session_manifest_hash",
        "namespaced_event_type",
        "payload_schema_hash",
        "opaque_project_payload",
        "provenance"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "plugin_id": { "$ref": "#/$defs/Identifier" },
        "project_instance_key": { "$ref": "#/$defs/Identifier" },
        "sequence": { "type": "integer", "minimum": 0 },
        "prior_project_state_revision": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "operation_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Identifier" }
          ]
        },
        "session_manifest_hash": { "$ref": "#/$defs/Hash" },
        "namespaced_event_type": { "$ref": "#/$defs/NamespacedIdentifier" },
        "payload_schema_hash": { "$ref": "#/$defs/Hash" },
        "opaque_project_payload": { "$ref": "#/$defs/CanonicalJsonValue" },
        "provenance": { "$ref": "#/$defs/JournalProvenance" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sequence": { "const": 0 } },
            "required": ["sequence"]
          },
          "then": {
            "properties": {
              "prior_project_state_revision": { "type": "null" },
              "operation_id": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "prior_project_state_revision": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "ProjectState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "project_instance_key",
        "project_registration_hash",
        "project_state_schema_hash",
        "revision",
        "last_journal_sequence",
        "state_hash",
        "canonical_opaque_payload"
      ],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/Identifier" },
        "project_instance_key": { "$ref": "#/$defs/Identifier" },
        "project_registration_hash": { "$ref": "#/$defs/Hash" },
        "project_state_schema_hash": { "$ref": "#/$defs/Hash" },
        "revision": { "type": "integer", "minimum": 0 },
        "last_journal_sequence": { "type": "integer", "minimum": 0 },
        "state_hash": { "$ref": "#/$defs/Hash" },
        "canonical_opaque_payload": { "$ref": "#/$defs/CanonicalJsonValue" }
      }
    },
    "ProjectInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "project_instance_key",
        "project_registration_hash",
        "project_state_schema_hash",
        "baseline_event_type",
        "creation_event_id",
        "current_project_state_revision",
        "current_project_state_hash",
        "mutation_chain_operation_id"
      ],
      "properties": {
        "plugin_id": { "$ref": "#/$defs/Identifier" },
        "project_instance_key": { "$ref": "#/$defs/Identifier" },
        "project_registration_hash": { "$ref": "#/$defs/Hash" },
        "project_state_schema_hash": { "$ref": "#/$defs/Hash" },
        "baseline_event_type": { "$ref": "#/$defs/NamespacedIdentifier" },
        "creation_event_id": { "$ref": "#/$defs/Identifier" },
        "current_project_state_revision": { "type": "integer", "minimum": 0 },
        "current_project_state_hash": { "$ref": "#/$defs/Hash" },
        "mutation_chain_operation_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Identifier" }
          ]
        }
      }
    }
  }
}
